    <string name="guardrails_scheduled_title">Waiting to take effect</string>
    <string name="guardrails_scheduled_body">The looser limits apply from block %1$d (about a day). Until then the stricter values stay in force.</string>
    <string name="guardrails_sync_title">Sync first</string>
    <string name="guardrails_sync_body">Loosening a limit counts 144 blocks from the current chain height. Open Home and let it sync, then try again.</string>
