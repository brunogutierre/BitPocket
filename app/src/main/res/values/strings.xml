    <string name="guardrails_title">Spending limits</string>
    <string name="guardrails_intro">Limits count everything that leaves the wallet, fee included. Stricter limits apply at once; looser ones wait about 24 hours (144 blocks), so nobody can raise them and spend right away.</string>
