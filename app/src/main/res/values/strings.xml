    <string name="settings_vault">Vault</string>
    <string name="settings_vault_set_up">Set up the Vault</string>
    <string name="settings_vault_set_up_body">A second pocket that needs two keys to spend, with an heir.</string>
    <string name="settings_vault_import">Import a Vault backup</string>
    <string name="settings_vault_import_body">For a wallet restored from its recovery words.</string>
    <string name="settings_vault_export">Save the Vault backup</string>
    <string name="settings_vault_export_body">Any of the three Vault keys can open it.</string>
    <string name="vault_setup_title">Set up the Vault</string>
    <string name="vault_setup_start">Start</string>
    <string name="vault_next">Next</string>
    <string name="vault_intro_body">The Vault is a second pocket for larger amounts. Every spend needs this phone AND a recovery key that you keep on paper, offline. An heir key can spend alone once the coins have not moved for a while, so they are never lost.</string>
    <string name="vault_intro_risk_title">Three sets of words</string>
    <string name="vault_intro_risk_body">You will write down 12 recovery words and 12 heir words. Losing the recovery words means only the heir can spend, after the waiting time. Store them apart from each other.</string>
    <string name="vault_timelock_title">Heir waiting time</string>
    <string name="vault_timelock_body">How long Vault coins must stay unmoved before the heir key alone can spend them. Spending or refreshing the Vault restarts the wait.</string>
    <string name="timelock_hour">About 1 hour (6 blocks), to try it on Signet</string>
    <string name="timelock_day">About 1 day (144 blocks)</string>
    <string name="timelock_month">About 1 month (4 320 blocks)</string>
    <string name="timelock_year">About 1 year (52 560 blocks)</string>
    <string name="vault_recovery_title">Recovery words</string>
    <string name="vault_recovery_body">Needed with this phone for every Vault spend. Keep them offline, away from this phone.</string>
    <string name="vault_heir_title">Heir words</string>
    <string name="vault_heir_body">Give them to your heir, or keep them as a delayed backup. They spend alone after the waiting time.</string>
    <string name="vault_pin_setup">Enter your PIN to create the Vault.</string>
    <string name="vault_pin_import">Enter your PIN to import the Vault backup.</string>
